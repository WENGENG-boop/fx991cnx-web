// Cloudflare Workers static-assets deployment of dist/ (built by tools/build-site.mjs).
{
	"name": "fx991cnx-web",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"routes": [
		{ "pattern": "calculator.weo.asia", "custom_domain": true }
	]
}
